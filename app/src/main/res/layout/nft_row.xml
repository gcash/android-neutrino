<?xml version="1.0" encoding="utf-8"?>
<!-- A row of a token's collection: an NFT's art, its name or commitment and what it can do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/list_row"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/nftIcon"
        android:layout_width="@dimen/token_row_icon"
        android:layout_height="@dimen/token_row_icon"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/nftCommitment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/nftCapability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        android:textColor="@color/grey"
        android:textSize="15sp" />
</LinearLayout>
