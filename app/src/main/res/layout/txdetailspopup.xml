<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls when the details are taller than the screen, as a transaction with many NFTs can be.
     The card has no vertical gravity, as a ScrollView would cut off the top of a tall one. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gradient"
    android:padding="10dp"
    android:id="@+id/txDetailsLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF">

        <ImageView
            android:id="@+id/txDetailsArrow"
            android:importantForAccessibility="no"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            app:srcCompat="@drawable/receive_arrow"/>

        <TextView
            android:layout_marginTop="20dp"
            android:id="@+id/txDetailsBchAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="25sp"
            android:layout_gravity="center"
            android:text="" />

        <TextView
            android:id="@+id/txDetailsFiatAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="15sp"
            android:text="" />

        <!-- The BCH that stays with the transaction's tokens, if any. -->
        <TextView
            android:id="@+id/txDetailsTokenBch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- How the transaction changed the wallet's tokens, if it did. -->
        <LinearLayout
            android:id="@+id/txDetailsTokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">


            <TextView
                android:layout_width="@dimen/tx_details_label"
                android:layout_height="wrap_content"
                android:text="@string/tx_details_date" />


            <TextView
                android:id="@+id/txDetailsDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="" />
        </LinearLayout>

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">


            <TextView
                android:layout_width="@dimen/tx_details_label"
                android:layout_height="wrap_content"
                android:text="@string/tx_details_status" />


            <ImageView
                android:id="@+id/confirmationCircle"
                android:importantForAccessibility="no"
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:srcCompat="@drawable/red_circle"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/txDetailsStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="" />
        </LinearLayout>

        <View
            android:id="@+id/txDetailsToDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:id="@+id/txDetailsToRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">


            <TextView
                android:layout_width="@dimen/tx_details_label"
                android:layout_height="wrap_content"
                android:text="@string/tx_details_to" />


            <TextView
                android:id="@+id/txDetailsTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textIsSelectable="true" />
        </LinearLayout>

        <View
            android:id="@+id/divider3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">


            <TextView
                android:layout_width="@dimen/tx_details_label"
                android:layout_height="wrap_content"
                android:text="@string/tx_details_id" />


            <TextView
                android:id="@+id/txDetailsTxid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                tools:text="cb92d348d9e2af41425409c02aff4f8c79047d1f21a9e56803a8a84b890fa05d" />
        </LinearLayout>

        <View
            android:id="@+id/divider4"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">


            <TextView
                android:layout_width="@dimen/tx_details_label"
                android:layout_height="wrap_content"
                android:text="@string/tx_details_memo" />


            <TextView
                android:id="@+id/txDetailsMemo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end" />
        </LinearLayout>

        <View
            android:id="@+id/divider5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="10dp">


            <TextView
                android:layout_width="@dimen/tx_details_label"
                android:layout_height="wrap_content"
                android:text="@string/tx_details_explorer" />


            <TextView
                android:id="@+id/txDetailsLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoLink="web"/>
        </LinearLayout>


    </LinearLayout>
</ScrollView>