<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the hidden tokens: a token's icon, name or short token ID and amount, as on the Tokens
     page, and Show. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/list_row"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/hiddenTokenIcon"
        android:layout_width="@dimen/token_row_icon"
        android:layout_height="@dimen/token_row_icon"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no" />

    <!-- Takes what the amount and Show leave, as they have to show whole. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hiddenTokenId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hiddenTokenBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/hiddenTokenAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="2"
        android:maxWidth="@dimen/tx_row_amount"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hiddenTokenShow"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/show_token"
        android:textAllCaps="true"
        android:textColor="@color/colorAccent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
