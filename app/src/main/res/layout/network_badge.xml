<?xml version="1.0" encoding="utf-8"?>
<!-- Names the test network the wallet runs on, so that its coins, which have no value, aren't
     taken for real ones. Networks.showBadge shows it on a test network only. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/networkBadge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/network_badge"
    android:paddingStart="8dp"
    android:paddingTop="2dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp"
    android:textAllCaps="true"
    android:textColor="@color/networkBadgeText"
    android:textSize="12sp"
    android:textStyle="bold"
    android:visibility="gone" />
