<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/list_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/txRowLayout">

    <ImageView
        android:id="@+id/arrowImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:srcCompat="@drawable/receive_arrow"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/arrow_image" />

    <!-- Takes what the amount leaves, as the amount has to show whole. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txMemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/bchAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="@dimen/tx_row_amount"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/fiatAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"/>
    </LinearLayout>
</LinearLayout>