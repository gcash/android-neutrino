<?xml version="1.0" encoding="utf-8"?>
<!-- The dots that show which page of the Tor walkthrough is shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginBottom="10dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="15dip">

    <View
        android:id="@+id/torCircle1"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/rounded_cell" />

    <View
        android:id="@+id/torCircle2"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/rounded_cell" />

    <View
        android:id="@+id/torCircle3"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/rounded_cell" />

    <View
        android:id="@+id/torCircle4"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/rounded_cell" />

    <View
        android:id="@+id/torCircle5"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/rounded_cell" />

</LinearLayout>
