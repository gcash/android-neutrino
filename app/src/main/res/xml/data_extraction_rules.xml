<?xml version="1.0" encoding="utf-8"?>
<!-- The wallet's keys and recovery phrase must not leave the device in a cloud
     backup or a transfer to a new device, where a wallet encrypted with a
     fingerprint could not be unlocked either. A wallet is moved by restoring
     it from its recovery phrase. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
