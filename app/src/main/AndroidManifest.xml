<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait">
        </activity>
        <!-- The only entry point for other apps and NFC tags. It reads nothing
             but the bitcoincash or bchtest URI and opens the screen that handles
             it, which says so when the URI is for another network than the
             wallet's. -->
        <activity
            android:name=".UriActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait">

            <intent-filter>
                <data android:scheme="bitcoincash" />
                <data android:scheme="bchtest" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="bitcoincash" />
                <data android:scheme="bchtest" />
            </intent-filter>
        </activity>
        <!-- Large screens ignore the portrait lock, so the screens below that hold a payment or
             ask for the screen lock keep themselves when the screen rotates or is resized, rather
             than being recreated. A recreated send screen applied its payment link again over
             what was typed, so that an amount switched to the fiat currency was read as BCH, and
             lost a payment request it was downloading. The other screens lost the unit of their
             amount, the answer to the screen lock prompt, or the dialog that was open, and the
             backup asked for the screen lock again and started over. -->
        <activity
            android:name=".SendActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
        </activity>
        <activity
            android:name=".ReceiveActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
        </activity>
        <activity
            android:name=".ConfirmationActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait">
        </activity>
        <!-- Kept through rotation and resizing too, as the send screens above are. -->
        <activity
            android:name=".BackupActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar.White"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
        </activity>
        <activity
            android:name=".RestoreActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar.White"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
        </activity>
        <activity
            android:name=".PinActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait">
        </activity>
        <activity
            android:name=".TorActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar.White"
            android:screenOrientation="portrait">
        </activity>
    </application>

</manifest>
